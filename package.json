{
  "name": "@mrburdeveloperteam/pet-function",
  "version": "0.9.16",
  "description": "Shared Cat Mascot, Molar AI chatbox, and Virtual Pet UI/runtime for the Snabbb app suite. Skeleton/foundation phase — see README.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBurDeveloperTeam/pet-function.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./apps": {
      "types": "./dist/apps.d.ts",
      "import": "./dist/apps.js"
    },
    "./apps/inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./apps/appointment": {
      "types": "./dist/appointment.d.ts",
      "import": "./dist/appointment.js"
    },
    "./apps/todo": {
      "types": "./dist/todo.d.ts",
      "import": "./dist/todo.js"
    },
    "./apps/calculator": {
      "types": "./dist/calculator.d.ts",
      "import": "./dist/calculator.js"
    },
    "./apps/elearning": {
      "types": "./dist/elearning.d.ts",
      "import": "./dist/elearning.js"
    },
    "./apps/image-generator": {
      "types": "./dist/image-generator.d.ts",
      "import": "./dist/image-generator.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./cat": {
      "types": "./dist/cat.d.ts",
      "import": "./dist/cat.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./pet": {
      "types": "./dist/pet.d.ts",
      "import": "./dist/pet.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./options": {
      "types": "./dist/options.d.ts",
      "import": "./dist/options.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./vite-games": "./scripts/vite-games.mjs"
  },
  "files": [
    "dist",
    "public",
    "scripts"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.34.5",
    "lucide-react": "^0.576.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2"
  }
}

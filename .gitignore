# Standalone texture copies are embedded in the Cat Kart GLBs.
/godot/cat-kart/models/*.png
/godot/cat-kart/models/*.png.import
# Editable scenes emitted by export_models.gd; runtime uses built/*.scn.
/godot/cat-kart/models/*.tscn
# Historical sculpt variants; active kart and driver GLBs stay versioned.
/godot/cat-kart/models/*_sculpt.glb
/godot/cat-kart/models/*_sculpt.glb.import

# Local UI verification captures and account-specific verification notes.
/database/air-strike-*.png
/database/AIR-STRIKE-LIVE-VERIFICATION.md

# Superseded hangar artwork; current UI uses hangar-rankings.png.
/public/games/air-strike/hangar.png
/public/games/air-strike/hangar-integrated.png
/public/games/air-strike/hangar-talents.png
